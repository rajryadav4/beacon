<%-- Shared page header: Bootstrap 5, navbar, and the success/error messages.
     Before including, set pageTitle and activeNav (incidents | users | routes) with c:set. --%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CrimeRadar: <c:out value="${pageTitle}" /></title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<style>
	body { background: #f6f7f9; }
	.navbar-brand .dot { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%;
		background: #e5484d; margin-right: .4rem; vertical-align: middle; }
	.table td, .table th { vertical-align: middle; }
	.risk-bar { height: .5rem; border-radius: .25rem; background: #e5484d; min-width: 2px; }
	.mono { font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
	<div class="container">
		<a class="navbar-brand fw-semibold" href="${pageContext.request.contextPath}/findincidents"><span class="dot"></span>CrimeRadar</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
			aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="nav">
			<ul class="navbar-nav ms-auto">
				<li class="nav-item"><a class="nav-link ${activeNav == 'incidents' ? 'active' : ''}" href="${pageContext.request.contextPath}/findincidents">Incidents</a></li>
				<li class="nav-item"><a class="nav-link ${activeNav == 'users' ? 'active' : ''}" href="${pageContext.request.contextPath}/findusers">Users</a></li>
				<li class="nav-item"><a class="nav-link ${activeNav == 'routes' ? 'active' : ''}" href="${pageContext.request.contextPath}/saferoutes">Safe Routes</a></li>
			</ul>
		</div>
	</div>
</nav>
<main class="container pb-5">
	<c:if test="${not empty messages.success}">
		<div id="successMessage" class="alert alert-success" role="status"><c:out value="${messages.success}" /></div>
	</c:if>
	<c:if test="${not empty messages.error}">
		<div id="errorMessage" class="alert alert-danger" role="alert"><c:out value="${messages.error}" /></div>
	</c:if>
